# ==========================================
# ВСЕ СЕКРЕТЫ ЖИВУТ ЗДЕСЬ, А НЕ В КОДЕ.
# Скопируйте файл как .env и заполните значения.
# .env добавлен в .gitignore и НИКОГДА не коммитится.
# ==========================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/voidcode?schema=public"
JWT_SECRET="сгенерируйте-длинную-случайную-строку"
JWT_EXPIRES_IN="7d"

# Ключи LLM-провайдеров — только на сервере
GEMINI_API_KEY=""
OPENROUTER_API_KEY=""
GROQ_API_KEY=""

# OpenAI: используется для DALL-E 3 (генерация картинок) и TTS-1 (озвучка).
# Один ключ на обе фичи — оба эндпоинта живут в одном аккаунте OpenAI.
OPENAI_API_KEY=""

# Fish Audio: второй TTS-провайдер (модель s2.1-pro), основной по
# умолчанию. https://fish.audio/app/api-keys
FISH_AUDIO_API_KEY=""

# (устаревшее) Генерация изображений через DeepInfra — оставлено на случай
# отката. Пока используется OpenAI DALL-E 3, эта переменная не требуется.
DEEPINFRA_API_KEY=""

# Публичный адрес приложения (для заголовков OpenRouter, return_url ЮKassa)
APP_URL="https://void-code.ru"

# ЮKassa — приём платежей. shopId и секретный ключ из ЛК ЮKassa
# (Настройки → API-ключи). Секрет НИКОГДА не коммитить — только здесь, в .env.
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""

# Шифрование пользовательских ключей провайдеров (32 байта hex)
PROVIDER_KEY_SECRET=""

# Шифрование секретов в БД (пароль почтового ящика, токены коннекторов).
# Любая длинная строка — используется постоянно, менять нельзя (иначе ранее
# сохранённые токены/пароли станут нерасшифровываемыми).
ENCRYPTION_KEY=""

# ── Коннекторы (#3): реальные интеграции внешних сервисов ──
# Публичный базовый URL API для OAuth redirect_uri. По умолчанию собирается
# из APP_URL как ${APP_URL}/api/v1 — задавайте, только если API живёт иначе.
API_PUBLIC_URL=""

# GitHub OAuth App (Settings → Developer settings → OAuth Apps).
# Authorization callback URL: https://void-code.ru/api/v1/connectors/github/callback
GITHUB_OAUTH_CLIENT_ID=""
GITHUB_OAUTH_CLIENT_SECRET=""

# Notion public integration (OAuth). Redirect URI:
# https://void-code.ru/api/v1/connectors/notion/callback
NOTION_CLIENT_ID=""
NOTION_CLIENT_SECRET=""

# Voximplant — телефония для «Агента звонков» (номер + исходящие/входящие).
# account_id и api_key из панели Voximplant (Settings → API access).
VOXIMPLANT_ACCOUNT_ID=""
VOXIMPLANT_API_KEY=""

# Telegram подключается пользователем через бот-токен в интерфейсе — общий
# серверный TELEGRAM_BOT_TOKEN не обязателен для коннектора.

# Photoroom — удаление фона у изображений (#8). Ключ из панели Photoroom
# (Apps → API keys). https://app.photoroom.com/api-dashboard
PHOTOROOM_API_KEY=""
